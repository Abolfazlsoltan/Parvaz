; Neon Survivor — Godot 4.4.1
config_version=5

[application]
config/name="Parvaz"
config/description="Mobile-first arcade air-combat campaign with unlockable missions and aircraft."
config/version="1.3.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.012, 0.02, 0.055, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/show_image=true

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.055, 1)

[input]
dash={"deadzone":0.2,"events":[Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)]}

[android]
modules=""
